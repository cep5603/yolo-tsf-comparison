{
  "source": "training_main",
  "dataset": "ili",
  "dataset_label": "National Illness",
  "eval_protocol": "patchtst",
  "features": "M",
  "window": 104,
  "horizon": 48,
  "epochs": 50,
  "lr": 0.0001,
  "batch_size": 64,
  "use_skip": true,
  "use_revin": true,
  "patch_len": 16,
  "patch_stride": 8,
  "repeats": 5,
  "band_split": [
    10,
    80,
    10
  ],
  "decomp_mode": "moving_avg",
  "trend_kernel": 0,
  "seasonal_kernel": 5,
  "level_loss_weight": 0.5,
  "target_loss_weight": 1.0,
  "monitor_target_channel": false,
  "feature_columns": [
    "% WEIGHTED ILI",
    "%UNWEIGHTED ILI",
    "AGE 0-4",
    "AGE 5-24",
    "ILITOTAL",
    "NUM. OF PROVIDERS",
    "OT"
  ],
  "target_col": "OT"
}