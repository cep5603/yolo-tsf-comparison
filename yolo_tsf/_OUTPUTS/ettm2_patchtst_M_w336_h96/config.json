  "decomp_mode": "moving_avg",
  "trend_kernel": 0,
  "seasonal_kernel": 17,
  "level_loss_weight": 0.5,
  "target_loss_weight": 1.0,
  "monitor_target_channel": false,
  "feature_columns": [
    "HUFL",
    "HULL",
    "MUFL",
    "MULL",
    "LUFL",
    "LULL",
    "OT"
  ],
  "target_col": "OT"
}